{
  "name": "fibaro10-desktop-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "parse:css": "node scripts/parse-css.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:routes": "node scripts/audit-routes.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "lint:microapps": "cd .. && node desktop_v2/node_modules/eslint/bin/eslint.js --config eslint.config.js desktop_v2/src packages/microapp-ui/src shell_app/frontend/src revenue_app/frontend/src parking_app/frontend/src sun_app/frontend/src energy_app/frontend/src operations_app/frontend/src maintenance_app/frontend/src system_app/frontend/src link_app/frontend/src",
    "test:components": "vitest run tests/microapp-components.test.tsx",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && vite build",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@tanstack/react-query": "^5.101.1",
    "@vitejs/plugin-react": "^4.6.0",
    "antd": "^5.26.0",
    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
