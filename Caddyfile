{
	admin off
}

(asset_cache) {
	@versioned_assets path /assets/*
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"
	@static_assets path /static/*
	header @static_assets Cache-Control "public, max-age=3600, must-revalidate"
}

(internal_app) {
	encode zstd gzip
	import asset_cache
	tls /certs/certificates/ny.lilletorget.net.crt /certs/certificates/ny.lilletorget.net.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@outside_lan not remote_ip private_ranges
	respond @outside_lan "Not found" 404
}

# One origin provides shared sign-in while each Mantis application remains an
# independently built path artifact.
https://ny.lilletorget.net {
	import internal_app
	reverse_proxy lilletorget_mantis:80
}

# Fixed 1920 x 1080 operations display. The application is a separate
# container, but shares authentication and the private HTTPS boundary.
https://kiosk.lilletorget.net {
	import internal_app
	reverse_proxy lilletorget_kiosk:80
}

online.lilletorget.net {
	encode zstd gzip
	import asset_cache

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy online_dashboard:8111 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

owntracks.lilletorget.net {
	encode zstd gzip
	import asset_cache

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@internal_api path /api/owntracks /api/owntracks/*
	respond @internal_api "Not found" 404

	reverse_proxy owntracks_service:8128 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

