{
	admin off
}

(asset_cache) {
	@versioned_assets path /assets/*
	header @versioned_assets Cache-Control "public, max-age=31536000, immutable"
	@static_assets path /static/*
	header @static_assets Cache-Control "public, max-age=3600, must-revalidate"
}

(internal_app) {
	encode zstd gzip
	import asset_cache
	tls /certs/certificates/fibaro10.lilletorget.net.crt /certs/certificates/fibaro10.lilletorget.net.key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@outside_lan not remote_ip private_ranges
	respond @outside_lan "Not found" 404

}

# These names exist in public DNS, but resolve to the private QNAP address.
# DNS-01 gives them publicly trusted certificates without exposing an app.
https://fibaro10.lilletorget.net {
	import internal_app

	reverse_proxy fibaro10:8110 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

https://app.lilletorget.net {
	import internal_app

	handle /omsetning {
		redir /omsetning/ 308
	}
	handle_path /omsetning/* {
		reverse_proxy revenue_app:8151
	}
	handle /parkering {
		redir /parkering/ 308
	}
	handle_path /parkering/* {
		reverse_proxy parking_app:8152
	}
	handle /soling {
		redir /soling/ 308
	}
	handle_path /soling/* {
		reverse_proxy sun_app:8153
	}
	handle /koble {
		redir /koble/ 308
	}
	handle_path /koble/* {
		reverse_proxy link_app:8158
	}
	handle /drift {
		redir /drift/ 308
	}
	handle_path /drift/* {
		reverse_proxy operations_app:8155
	}
	handle /energi {
		redir /energi/ 308
	}
	handle_path /energi/* {
		reverse_proxy energy_app:8154
	}
	handle /vedlikehold {
		redir /vedlikehold/ 308
	}
	handle_path /vedlikehold/* {
		reverse_proxy maintenance_app:8156
	}
	handle /system {
		redir /system/ 308
	}
	handle_path /system/* {
		reverse_proxy system_app:8157
	}
	handle {
		reverse_proxy shell_app:8150
	}
}

